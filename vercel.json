      "permanent": true
    },
    {
      "source": "/politique-confidentialite/",
      "destination": "/fr/politique-confidentialite/",
      "permanent": true
    },
    {
      "source": "/creation-site-internet-la-rochelle",
      "destination": "/fr/creation-site-internet-la-rochelle/",
      "permanent": true
    },
